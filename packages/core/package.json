{
  "name": "@madscope/core",
  "version": "0.1.0",
  "description": "Core testing engine for MadScope (UI-agnostic)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@madscope/shared": "0.1.0",
    "@madscope/config": "0.1.0",
    "@madscope/browser": "0.1.0",
    "@madscope/screenshots": "0.1.0",
    "@madscope/visual-diff": "0.1.0",
    "@madscope/issue-detector": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "rimraf": "^6.0.1"
  }
}
